# Copy to docker/.env and adjust. docker/.env is not committed.

# Host folder that contains the projects to analyze. It is mounted read-write
# at the same path inside the container; only projects below it can be analyzed.
PROJECTS_DIR=/Users/your-name/projects

# Ollama on the host. The default works with Docker Desktop (macOS/Windows).
# On Linux, start Ollama with OLLAMA_HOST=0.0.0.0 so the container can reach it.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Linux only: run the container as your user so files written by the tool keep
# your ownership. Use the output of `id -u` and `id -g`.
# HOST_UID=1000
# HOST_GID=1000
